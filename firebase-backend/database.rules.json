{
  "rules": {
    ".read": "auth != null",
    ".write": "auth != null",
    "devices": {
      ".indexOn": ["lastUpdated"],
      "$deviceId": {
        ".read": true,
        ".write": true,
        "commands": {
          "$commandId": {
            ".indexOn": ["timestamp", "executed"],
            ".write": "auth != null"
          }
        },
        "auditLogs": {
          ".indexOn": ["timestamp"]
        },
        "securityAlerts": {
          ".write": false
        }
      }
    }
  }
}
